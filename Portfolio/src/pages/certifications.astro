---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { certifications } from '../data/profile';
import { SITE_DESCRIPTION } from '../consts';

const months: Record<string, number> = {
  enero: 1,
  febrero: 2,
  marzo: 3,
  abril: 4,
  mayo: 5,
  junio: 6,
  julio: 7,
  agosto: 8,
  septiembre: 9,
  octubre: 10,
  noviembre: 11,
  diciembre: 12,
};

const getCertificationIcon = (category: string) => {
  const normalizedCategory = category.toLowerCase();

  if (normalizedCategory.includes('inteligencia')) return 'uil-brain';
  if (normalizedCategory.includes('ingles')) return 'uil-comment-alt-message';
  if (normalizedCategory.includes('evento')) return 'uil-map-marker-alt';
  if (normalizedCategory.includes('linux')) return 'uil-linux';
  if (normalizedCategory.includes('agile')) return 'uil-sync';
  if (normalizedCategory.includes('proyectos')) return 'uil-clipboard-alt';
  if (normalizedCategory.includes('habilidades')) return 'uil-heart';
  if (normalizedCategory.includes('crecimiento')) return 'uil-rocket';
  return 'uil-award';
};

const sortedCertifications = certifications
  .map((certificate, originalIndex) => {
    const [monthName, year] = certificate.date.toLowerCase().split(' ');
    const month = months[monthName] ?? 0;

    return {
      ...certificate,
      originalIndex,
      icon: getCertificationIcon(certificate.category),
      timestamp: Number(year) * 100 + month,
      isoDate: `${year}-${String(month).padStart(2, '0')}`,
    };
  })
  .sort((a, b) => b.timestamp - a.timestamp || a.title.localeCompare(b.title));

const featuredCertifications = sortedCertifications.slice(0, 3);
const categories = Array.from(new Set(certifications.map((certificate) => certificate.category)));
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Certificaciones | Luis Eduardo Gutiérrez Arias" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="cert-page">
      <section class="cert-hero section">
        <div class="cert-hero__container container">
          <a class="cert-hero__back" href="/#certifications">
            <i class="uil uil-arrow-left"></i>
            <span data-i18n="certifications.page.back">Volver al portafolio</span>
          </a>

          <div class="cert-hero__layout">
            <div class="cert-hero__copy">
              <span class="cert-hero__eyebrow" data-i18n="certifications.page.subtitle">Biblioteca de credenciales</span>
              <h1 data-i18n="certifications.page.title">Certificaciones</h1>
              <p data-i18n="certifications.page.intro">
                Una vista más completa de certificados, cursos y experiencias de aprendizaje que respaldan mi crecimiento técnico, gestión de proyectos, inglés y desarrollo profesional.
              </p>
            </div>

            <div class="cert-hero__stats" aria-label="Resumen de certificaciones">
              <span>
                <strong>{certifications.length}</strong>
                <small data-i18n="certifications.credentials">credenciales</small>
              </span>
              <span>
                <strong>{categories.length}</strong>
                <small>áreas</small>
              </span>
              <span>
                <strong>2026</strong>
                <small>recientes</small>
              </span>
            </div>
          </div>
        </div>
      </section>

      <section class="cert-section">
        <div class="container cert-section__container">
          <div class="cert-section__head">
            <h2 data-i18n="certifications.page.featured">Credenciales destacadas</h2>
          </div>

          <div class="cert-featured">
            {featuredCertifications.map((certificate) => (
              <article class="cert-featured__card">
                <span class="cert-featured__icon" aria-hidden="true">
                  <i class={`uil ${certificate.icon}`}></i>
                </span>
                <span class="cert-featured__category" data-i18n={`certifications.${certificate.originalIndex}.category`}>
                  {certificate.category}
                </span>
                <h3>{certificate.title}</h3>
                <p data-i18n={`certifications.${certificate.originalIndex}.description`}>
                  {certificate.description}
                </p>
                <footer>
                  <small>{certificate.issuer}</small>
                  <time datetime={certificate.isoDate} data-i18n={`certifications.${certificate.originalIndex}.date`}>
                    {certificate.date}
                  </time>
                </footer>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cert-section cert-section--library">
        <div class="container cert-section__container">
          <div class="cert-section__head">
            <h2 data-i18n="certifications.page.all">Todas las credenciales</h2>
            <p data-i18n="certifications.hint">Selecciona una credencial para conocer los detalles</p>
          </div>

          <div class="cert-grid" data-certifications-list>
            {sortedCertifications.map((certificate) => (
              <details class="cert-card">
                <summary>
                  <span class="cert-card__icon" aria-hidden="true">
                    <i class={`uil ${certificate.icon}`}></i>
                  </span>

                  <span class="cert-card__summary">
                    <span class="cert-card__category" data-i18n={`certifications.${certificate.originalIndex}.category`}>
                      {certificate.category}
                    </span>
                    <strong>{certificate.title}</strong>
                    <small>{certificate.issuer}</small>
                  </span>

                  <time datetime={certificate.isoDate} data-i18n={`certifications.${certificate.originalIndex}.date`}>
                    {certificate.date}
                  </time>

                  <i class="uil uil-angle-down cert-card__arrow" aria-hidden="true"></i>
                </summary>

                <div class="cert-card__details">
                  <p data-i18n={`certifications.${certificate.originalIndex}.description`}>
                    {certificate.description}
                  </p>

                  <div class="cert-card__actions">
                    {certificate.credentialUrl && (
                      <a href={certificate.credentialUrl} target="_blank" rel="noreferrer">
                        <i class="uil uil-external-link-alt"></i>
                        <span data-i18n="certifications.view">Ver certificado</span>
                      </a>
                    )}
                    {certificate.downloadUrl && (
                      <a href={certificate.downloadUrl} target="_blank" rel="noreferrer" download>
                        <i class="uil uil-download-alt"></i>
                        <span data-i18n="certifications.download">Descargar</span>
                      </a>
                    )}
                    {!certificate.credentialUrl && !certificate.downloadUrl && (
                      <span class="cert-card__pending">
                        <i class="uil uil-link-broken"></i>
                        <span data-i18n="certifications.pending">Link pendiente</span>
                      </span>
                    )}
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .cert-page {
    min-height: 100vh;
  }

  .cert-hero {
    padding-bottom: 2.5rem;
  }

  .cert-hero__container,
  .cert-section__container {
    display: grid;
    gap: 1.5rem;
  }

  .cert-hero__back {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: var(--first-color);
    font-weight: var(--font-medium);
  }

  .cert-hero__layout {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }

  .cert-hero__copy {
    min-width: 0;
  }

  .cert-hero__eyebrow,
  .cert-card__category,
  .cert-featured__category {
    color: var(--first-color);
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .cert-hero h1 {
    margin-top: .4rem;
    font-size: clamp(2.75rem, 7vw, 5.45rem);
    line-height: .95;
    overflow-wrap: normal;
    word-break: normal;
  }

  .cert-hero p {
    max-width: 760px;
    margin-top: 1rem;
    color: var(--text-color);
    line-height: 1.75;
  }

  .cert-hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
  }

  .cert-hero__stats span {
    display: grid;
    gap: .15rem;
    justify-items: center;
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: .75rem;
    background: var(--container-color);
    box-shadow: 0 14px 32px rgba(39, 62, 84, .06);
  }

  .cert-hero__stats strong {
    color: var(--first-color);
    font-size: clamp(1.75rem, 3vw, 2.55rem);
    line-height: 1;
    overflow-wrap: normal;
    white-space: nowrap;
  }

  .cert-hero__stats small {
    color: var(--text-color-light);
    font-size: var(--small-font-size);
    text-align: center;
    white-space: nowrap;
  }

  .cert-section {
    padding: 1rem 0 3.5rem;
  }

  .cert-section__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .cert-section__head h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  .cert-section__head p {
    color: var(--text-color-light);
  }

  .cert-featured {
    display: grid;
    gap: 1rem;
  }

  .cert-featured__card {
    display: grid;
    gap: .75rem;
    padding: 1.1rem;
    border: 1px solid var(--border-color);
    border-radius: .85rem;
    background:
      linear-gradient(140deg, rgba(85, 157, 226, .12), rgba(255, 255, 255, .96) 48%),
      var(--container-color);
    box-shadow: 0 16px 38px rgba(39, 62, 84, .07);
  }

  .cert-featured__icon,
  .cert-card__icon {
    width: 2.85rem;
    height: 2.85rem;
    display: grid;
    place-items: center;
    border-radius: .7rem;
    background: var(--first-color-lighter);
    color: var(--first-color-alt);
    font-size: 1.35rem;
  }

  .cert-featured__card h3 {
    color: var(--title-color);
    font-size: var(--h3-font-size);
  }

  .cert-featured__card p,
  .cert-card__details p {
    color: var(--text-color);
    line-height: 1.65;
  }

  .cert-featured__card footer {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    justify-content: space-between;
    color: var(--text-color-light);
    font-size: var(--small-font-size);
  }

  .cert-grid {
    display: grid;
    gap: .85rem;
  }

  .cert-card {
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: .8rem;
    background: var(--container-color);
    box-shadow: 0 12px 28px rgba(39, 62, 84, .05);
  }

  .cert-card summary {
    display: grid;
    grid-template-columns: 2.85rem minmax(0, 1fr) auto 1.25rem;
    align-items: center;
    gap: .85rem;
    padding: .9rem 1rem;
    cursor: pointer;
    list-style: none;
  }

  .cert-card summary::-webkit-details-marker {
    display: none;
  }

  .cert-card summary:hover,
  .cert-card[open] summary {
    background: rgba(85, 157, 226, .06);
  }

  .cert-card__summary {
    display: grid;
    gap: .14rem;
    min-width: 0;
  }

  .cert-card__summary strong {
    overflow: hidden;
    color: var(--title-color);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cert-card__summary small,
  .cert-card time {
    color: var(--text-color-light);
    font-size: var(--smaller-font-size);
  }

  .cert-card__arrow {
    color: var(--first-color);
    font-size: 1.2rem;
    transition: transform .25s ease;
  }

  .cert-card[open] .cert-card__arrow {
    transform: rotate(180deg);
  }

  .cert-card__details {
    display: grid;
    gap: .85rem;
    margin: 0 1rem 1rem 4.85rem;
    padding: .9rem 1rem;
    border-left: 2px solid var(--first-color);
    border-radius: 0 .55rem .55rem 0;
    background: rgba(85, 157, 226, .045);
  }

  .cert-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
  }

  .cert-card__actions a,
  .cert-card__pending {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .4rem .7rem;
    border: 1px solid var(--border-color);
    border-radius: .45rem;
    background: var(--container-color);
    color: var(--first-color);
    font-size: var(--small-font-size);
    font-weight: var(--font-medium);
  }

  .cert-card__pending {
    color: var(--text-color-light);
  }

  @media screen and (min-width: 768px) {
    .cert-featured {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 980px) {
    .cert-hero__layout {
      grid-template-columns: minmax(0, 1fr) minmax(340px, 400px);
    }

    .cert-hero h1 {
      white-space: nowrap;
    }
  }

  @media screen and (max-width: 640px) {
    .cert-hero__stats {
      grid-template-columns: 1fr;
    }

    .cert-section__head {
      align-items: flex-start;
      flex-direction: column;
    }

    .cert-card summary {
      grid-template-columns: 2.65rem minmax(0, 1fr) 1.1rem;
    }

    .cert-card time {
      grid-column: 2;
      grid-row: 2;
    }

    .cert-card__arrow {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    .cert-card__details {
      margin: 0 .75rem .85rem;
    }
  }
</style>
