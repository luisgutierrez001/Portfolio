---
import { profile } from '../data/profile';

const navItems = [
	{ href: '#home', label: 'Home', icon: 'uil-home' },
	{ href: '#about', label: 'About', icon: 'uil-user' },
	{ href: '#skills', label: 'Skills', icon: 'uil-book-alt' },
	{ href: '#projects', label: 'Projects', icon: 'uil-suitcase-alt' },
	{ href: '#experience', label: 'Experience', icon: 'uil-briefcase-alt' },
	{ href: '#certifications', label: 'Certs', icon: 'uil-award' },
	{ href: '#contact', label: 'Contact', icon: 'uil-envelope-add' },
];
---

<div class="container">
  <header class="header" id="header">
    <nav class="nav container">
      <a href="#home" class="nav__logo">{profile.name}</a>

      <div class="nav__menu" id="nav-menu">
        <ul class="nav__list grid">
          {
            navItems.map((item) => (
              <li class="nav__item">
                <a href={item.href} class="nav__link">
                  <i class={`uil ${item.icon} nav__icon`}></i>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button class="nav__close" id="nav-close" type="button" aria-label="Cerrar menu">
          <i class="uil uil-times-circle"></i>
        </button>
      </div>

      <div class="nav__btns">
        <button class="nav__toggle" id="nav-toggle" type="button" aria-label="Abrir menu">
          <i class="uil uil-apps"></i>
        </button>
      </div>
    </nav>
  </header>

  <style>
    .header {
      width: 100%;
      position: fixed;
      bottom: 0;
      left: 0;
      z-index: var(--z-fixed);
      background-color: rgba(253, 254, 255, .96);
      backdrop-filter: blur(10px);
    }

    .nav {
      max-width: var(--container-width);
      height: var(--header-height);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav__logo,
    .nav__toggle {
      color: var(--title-color);
      font-weight: var(--font-medium);
    }

    .nav__logo {
      max-width: 220px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nav__logo:hover,
    .nav__toggle:hover {
      color: var(--first-color);
    }

    .nav__toggle,
    .nav__close {
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .nav__toggle {
      font-size: 1.1rem;
    }

    @media screen and (max-width: 767px) {
      .nav__menu {
        position: fixed;
        bottom: -100%;
        left: 0;
        width: 100%;
        background-color: var(--body-color);
        padding: 2rem 1.5rem 4rem;
        box-shadow: 0 -1px 12px rgba(39, 62, 84, 0.12);
        border-radius: 1.25rem 1.25rem 0 0;
        transition: bottom 0.3s ease;
      }
    }

    .nav__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

    .nav__link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .2rem;
      font-size: var(--small-font-size);
      color: var(--title-color);
      font-weight: var(--font-medium);
      transition: color .25s ease, transform .25s ease;
    }

    .nav__link:hover {
      color: var(--first-color);
      transform: translateY(-1px);
    }

    .nav__icon {
      font-size: 1.2rem;
    }

    .nav__close {
      position: absolute;
      right: 1.3rem;
      bottom: .5rem;
      font-size: 1.5rem;
      color: var(--first-color);
    }

    .nav__close:hover {
      color: var(--first-color-alt);
    }

    .show-menu {
      bottom: 0;
    }

    @media screen and (min-width: 768px) {
      .header {
        top: 0;
        bottom: auto;
        box-shadow: 0 1px 8px rgba(39, 62, 84, 0.08);
      }

      .nav__menu {
        margin-left: auto;
      }

      .nav__list {
        display: flex;
        gap: 1rem;
      }

      .nav__link {
        flex-direction: row;
        gap: .35rem;
      }

      .nav__toggle,
      .nav__close {
        display: none;
      }
    }
  </style>
</div>
