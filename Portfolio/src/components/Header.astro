---
import { profile, translations } from '../data/profile';

const navItems = [
	{ href: '#home', label: 'Inicio', icon: 'uil-home', key: 'nav.home' },
	{ href: '#about', label: 'Sobre mi', icon: 'uil-user', key: 'nav.about' },
	{ href: '#skills', label: 'Habilidades', icon: 'uil-book-alt', key: 'nav.skills' },
	{ href: '#projects', label: 'Proyectos', icon: 'uil-suitcase-alt', key: 'nav.projects' },
	{ href: '#experience', label: 'Experiencia', icon: 'uil-briefcase-alt', key: 'nav.experience' },
	{ href: '#certifications', label: 'Certs', icon: 'uil-award', key: 'nav.certifications' },
	{ href: '#contact', label: 'Contacto', icon: 'uil-envelope-add', key: 'nav.contact' },
];
---

<script id="i18n-messages" type="application/json" set:html={JSON.stringify(translations)}></script>

<div>
  <header class="header" id="header">
    <nav class="nav container">
      <a href="#home" class="nav__logo">{profile.name}</a>

      <div class="nav__menu" id="nav-menu">
        <ul class="nav__list grid">
          {
            navItems.map((item) => (
              <li class="nav__item">
                <a href={item.href} class="nav__link">
                  <i class={`uil ${item.icon} nav__icon`}></i>
                  <span data-i18n={item.key}>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <button class="nav__close" id="nav-close" type="button" aria-label="Cerrar menu">
          <i class="uil uil-times-circle"></i>
        </button>
      </div>

      <div class="nav__btns">
        <button class="nav__lang" id="language-toggle" type="button" aria-label="Cambiar idioma" aria-pressed="false">
          <i class="uil uil-globe"></i>
          <span data-i18n="language.label">ES</span>
        </button>
        <button class="nav__toggle" id="nav-toggle" type="button" aria-label="Abrir menu">
          <i class="uil uil-apps"></i>
        </button>
      </div>
    </nav>
  </header>

  <style>
    .header {
      width: 100%;
      position: fixed;
      bottom: 0;
      left: 0;
      z-index: var(--z-fixed);
      background-color: rgba(253, 254, 255, .96);
      backdrop-filter: blur(10px);
    }

    .nav {
      width: min(calc(100% - 4rem), 1320px);
      max-width: 1320px;
      height: var(--header-height);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav__logo,
    .nav__toggle,
    .nav__lang {
      color: var(--title-color);
      font-weight: var(--font-medium);
    }

    .nav__logo {
      max-width: 280px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nav__logo:hover,
    .nav__toggle:hover,
    .nav__lang:hover {
      color: var(--first-color);
    }

    .nav__toggle,
    .nav__close,
    .nav__lang {
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .nav__btns {
      display: flex;
      align-items: center;
      gap: .6rem;
    }

    .nav__lang {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .35rem;
      min-width: 4.25rem;
      height: 2rem;
      padding: 0 .75rem;
      border: 1px solid transparent;
      border-radius: 999px;
      background-color: var(--input-color);
      box-shadow: inset 0 0 0 1px var(--border-color);
      font-size: var(--smaller-font-size);
      line-height: 1;
      transition: background-color .25s ease, box-shadow .25s ease, color .25s ease, transform .25s ease;
    }

    .nav__lang i {
      font-size: 1rem;
    }

    .nav__lang:hover {
      background-color: #fff;
      box-shadow: inset 0 0 0 1px var(--first-color-lighter), 0 8px 18px rgba(39, 62, 84, .08);
      transform: translateY(-1px);
    }

    .nav__lang[aria-pressed="true"] {
      background-color: var(--first-color);
      box-shadow: inset 0 0 0 1px var(--first-color);
      color: #fff;
    }

    .nav__lang[aria-pressed="true"]:hover {
      background-color: var(--first-color-alt);
      color: #fff;
    }

    .nav__toggle {
      font-size: 1.1rem;
    }

    @media screen and (max-width: 767px) {
      .nav__menu {
        position: fixed;
        bottom: -100%;
        left: 0;
        width: 100%;
        background-color: var(--body-color);
        padding: 2rem 1.5rem 4rem;
        box-shadow: 0 -1px 12px rgba(39, 62, 84, 0.12);
        border-radius: 1.25rem 1.25rem 0 0;
        transition: bottom 0.3s ease;
      }
    }

    .nav__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

    .nav__link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .2rem;
      font-size: var(--small-font-size);
      color: var(--title-color);
      font-weight: var(--font-medium);
      transition: color .25s ease, transform .25s ease;
    }

    .nav__link:hover {
      color: var(--first-color);
      transform: translateY(-1px);
    }

    .nav__icon {
      font-size: 1.2rem;
    }

    .nav__close {
      position: absolute;
      right: 1.3rem;
      bottom: .5rem;
      font-size: 1.5rem;
      color: var(--first-color);
    }

    .nav__close:hover {
      color: var(--first-color-alt);
    }

    .show-menu {
      bottom: 0;
    }

    @media screen and (min-width: 768px) {
      .header {
        top: 0;
        bottom: auto;
        box-shadow: 0 1px 8px rgba(39, 62, 84, 0.08);
      }

      .nav__menu {
        margin-left: auto;
        margin-right: 1rem;
      }

      .nav__list {
        display: flex;
        gap: clamp(.9rem, 1.6vw, 1.8rem);
      }

      .nav__link {
        flex-direction: row;
        gap: .35rem;
      }

      .nav__toggle,
      .nav__close {
        display: none;
      }
    }
  </style>
</div>
