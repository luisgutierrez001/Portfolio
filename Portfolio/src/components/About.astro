---
import { aboutStories, profile, projects } from '../data/profile';

const aboutStats = profile.stats.map((stat, index) => (
  index === 1 ? { ...stat, value: String(projects.length) } : stat
));
---

<section class="about section reveal" id="about">
  <h2 class="section__title" data-i18n="about.title">Sobre mi</h2>
  <span class="section__subtitle" data-i18n="about.subtitle">Quien soy</span>

  <div class="about__container container">
    <div class="about__overview grid">
      <figure class="about__photo">
        <img src={profile.fullBodyPhoto} alt={`Foto personal de ${profile.name}`} class="about__img" />
      </figure>

      <div class="about__content">
        <p class="about__description" data-i18n="about.summary">{profile.summary}</p>
        <p class="about__description about__description--secondary" data-i18n="about.detail">{profile.about}</p>

        <div class="about__info">
          {
            aboutStats.map((stat, index) => (
              <div class="about__stat">
                <span
                  class="about__info-title"
                  data-counter
                  data-counter-target={Number.parseInt(stat.value, 10)}
                  data-counter-suffix={stat.value.replace(/\d/g, '')}
                  aria-label={stat.value}
                >
                  {stat.value}
                </span>
                <span class="about__info-name" data-i18n={`about.stat.${index}`}>{stat.label}</span>
              </div>
            ))
          }
        </div>

        <ul class="about__focus" aria-label="Areas de enfoque">
          {
            profile.focus.map((item, index) => (
              <li>
                <i class="uil uil-check-circle"></i>
                <span data-i18n={`about.focus.${index}`}>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="about__stories">
      <div class="about__stories-head">
        <div>
          <h3 data-i18n="about.storyTitle">Mas alla del codigo</h3>
          <p data-i18n="about.storyIntro">
            Una mirada mas personal a experiencias que han formado mi manera de aprender, construir y colaborar.
          </p>
        </div>

        <div class="about__carousel-actions" aria-label="Controles del carrusel">
          <button class="about__carousel-button" type="button" data-carousel-prev="about-stories" aria-label="Historia anterior">
            <i class="uil uil-angle-left-b"></i>
          </button>
          <button class="about__carousel-button" type="button" data-carousel-next="about-stories" aria-label="Historia siguiente">
            <i class="uil uil-angle-right-b"></i>
          </button>
        </div>
      </div>

      <div
        class="about__carousel-track"
        data-carousel-track="about-stories"
        data-carousel-loop
        data-carousel-autoplay="4200"
        aria-label="Historias personales"
      >
        {
          aboutStories.map((story, index) => (
            <article class="about__story" data-carousel-card>
              <div class="about__story-media">
                {story.image ? (
                  <img src={story.image} alt={story.title} />
                ) : (
                  <div class="about__story-placeholder">
                    <i class={`uil ${story.icon}`}></i>
                    <span data-i18n="about.storyImage">Imagen pendiente</span>
                  </div>
                )}
                <span class="about__story-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>

              <div class="about__story-content">
                <span class="about__story-kicker" data-i18n={`about.story.${index}.category`}>{story.category}</span>
                <h4 data-i18n={`about.story.${index}.title`}>{story.title}</h4>
                <p data-i18n={`about.story.${index}.description`}>{story.description}</p>
                <div class="about__story-lesson">
                  <strong data-i18n="about.storyLesson">Que me dejo</strong>
                  <span data-i18n={`about.story.${index}.lesson`}>{story.lesson}</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <style>
    .about > .section__title {
      font-size: clamp(2.7rem, 7vw, 5rem);
      line-height: .92;
      letter-spacing: -.045em;
    }

    .about > .section__subtitle {
      margin-top: .55rem;
      color: var(--first-color);
      font-weight: var(--font-medium);
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .about__container {
      animation: fadeUp .7s ease both;
    }

    .about__overview {
      align-items: center;
      gap: 2rem;
      margin-bottom: clamp(3rem, 7vw, 5rem);
    }

    .about__photo {
      width: min(100%, 380px);
      justify-self: center;
      border-radius: .75rem;
      overflow: hidden;
      background: var(--container-color);
      box-shadow: 0 18px 35px rgba(39, 62, 84, .10);
    }

    .about__img {
      width: 100%;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .about__description {
      text-align: left;
      line-height: 1.75;
      margin-bottom: var(--mb-1);
    }

    .about__description--secondary {
      color: var(--text-color-light);
      margin-bottom: var(--mb-2);
    }

    .about__info {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: .75rem;
      margin-bottom: var(--mb-2);
    }

    .about__stat {
      border-left: 2px solid var(--first-color);
      padding-left: .85rem;
    }

    .about__info-title {
      min-height: 1em;
      font-size: clamp(2rem, 4vw, 3.25rem);
      line-height: 1;
      font-weight: var(--font-semi-bold);
      color: var(--title-color);
      font-variant-numeric: tabular-nums;
    }

    .about__info-name {
      font-size: var(--small-font-size);
      max-width: 120px;
    }

    .about__info-title,
    .about__info-name {
      display: block;
      text-align: left;
    }

    .about__focus {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: .75rem;
      margin-bottom: var(--mb-1);
    }

    .about__focus li {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: var(--title-color);
      font-size: var(--small-font-size);
      justify-content: flex-start;
    }

    .about__focus i {
      color: var(--first-color);
      font-size: 1.1rem;
    }

    .about__stories {
      width: 100%;
    }

    .about__stories-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .about__stories-head h3 {
      font-size: clamp(1.8rem, 4vw, 2.75rem);
      color: var(--title-color);
      margin-bottom: .35rem;
    }

    .about__stories-head p {
      color: var(--text-color-light);
      max-width: 620px;
      line-height: 1.7;
    }

    .about__carousel-actions {
      display: flex;
      gap: .65rem;
      flex-shrink: 0;
    }

    .about__carousel-button {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: .5rem;
      border: 1px solid rgba(59, 130, 246, .35);
      background: var(--body-color);
      color: var(--first-color);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      cursor: pointer;
      transition: transform .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
    }

    .about__carousel-button:hover {
      transform: translateY(-2px);
      background: var(--first-color);
      color: #fff;
      border-color: var(--first-color);
    }

    .about__carousel-track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(280px, 88%);
      gap: 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: .15rem;
      padding: .15rem .15rem 1rem;
      scrollbar-width: none;
    }

    .about__carousel-track::-webkit-scrollbar {
      display: none;
    }

    .about__story {
      scroll-snap-align: start;
      display: grid;
      gap: 1rem;
      padding: 1rem;
      border: 1px solid rgba(41, 56, 75, .08);
      border-radius: .65rem;
      background: var(--container-color);
      box-shadow: 0 14px 35px rgba(39, 62, 84, .08);
    }

    .about__story-media {
      position: relative;
      min-height: 180px;
      border-radius: .55rem;
      overflow: hidden;
      background: linear-gradient(135deg, rgba(59, 130, 246, .16), rgba(85, 157, 226, .06));
    }

    .about__story-media img {
      width: 100%;
      height: 100%;
      min-height: 180px;
      object-fit: cover;
      display: block;
    }

    .about__story-placeholder {
      min-height: 180px;
      height: 100%;
      display: grid;
      place-items: center;
      align-content: center;
      gap: .45rem;
      color: var(--first-color);
      text-align: center;
      font-size: var(--small-font-size);
    }

    .about__story-placeholder i {
      font-size: 2rem;
    }

    .about__story-number {
      position: absolute;
      left: .85rem;
      bottom: .75rem;
      padding: .3rem .55rem;
      border: 1px solid rgba(255, 255, 255, .7);
      border-radius: 999px;
      background: rgba(20, 30, 42, .7);
      color: #fff;
      font-size: var(--smaller-font-size);
      font-weight: var(--font-semi-bold);
      letter-spacing: .08em;
      backdrop-filter: blur(6px);
    }

    .about__story-content {
      display: flex;
      flex-direction: column;
      gap: .65rem;
    }

    .about__story-kicker {
      color: var(--first-color);
      font-size: var(--smaller-font-size);
      font-weight: var(--font-medium);
      text-transform: uppercase;
      letter-spacing: .06rem;
    }

    .about__story h4 {
      color: var(--title-color);
      font-size: var(--h3-font-size);
    }

    .about__story p,
    .about__story-lesson span {
      color: var(--text-color);
      line-height: 1.55;
    }

    .about__story-lesson {
      display: grid;
      gap: .25rem;
      margin-top: auto;
      padding: .75rem .85rem;
      border-left: 2px solid var(--first-color);
      border-radius: 0 .45rem .45rem 0;
      background: rgba(85, 157, 226, .07);
    }

    .about__story-lesson strong {
      color: var(--title-color);
      font-size: var(--small-font-size);
    }

    @media screen and (min-width: 768px) {
      .about__overview {
        grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
        column-gap: clamp(2.5rem, 7vw, 5rem);
      }

      .about__carousel-track {
        grid-auto-columns: minmax(620px, 760px);
      }

      .about__story {
        grid-template-columns: minmax(280px, 1fr) minmax(300px, .9fr);
        align-items: stretch;
      }

      .about__story-media,
      .about__story-media img,
      .about__story-placeholder {
        min-height: 300px;
      }
    }

    @media screen and (min-width: 1024px) {
      .about__content {
        max-width: 740px;
      }

      .about__carousel-track {
        grid-auto-columns: minmax(680px, 820px);
      }
    }

    @media screen and (max-width: 640px) {
      .about__description {
        text-align: center;
      }

      .about__info {
        grid-template-columns: 1fr;
      }

      .about__stat {
        border-left: 0;
        padding-left: 0;
      }

      .about__info-title,
      .about__info-name {
        text-align: center;
        max-width: none;
      }

      .about__stories-head {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</section>
