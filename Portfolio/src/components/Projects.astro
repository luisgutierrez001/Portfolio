---
import { projects } from '../data/profile';

const fallbackVisuals = [
  { kind: 'overview', label: 'Vista general', key: 'projects.visual.overview', icon: 'uil-window' },
  { kind: 'technology', label: 'Tecnologia', key: 'projects.visual.technology', icon: 'uil-brackets-curly' },
  { kind: 'impact', label: 'Impacto', key: 'projects.visual.impact', icon: 'uil-chart-growth' },
];

const getProjectSlides = (project: (typeof projects)[number]) => {
  const images = project.images
    .map((src, index) => ({ src, alt: `${project.title}, imagen ${index + 1}` }));

  return images.length > 0 ? images : fallbackVisuals;
};
---

<section class="projects section reveal" id="projects">
  <h2 class="section__title" data-i18n="projects.title">Proyectos</h2>
  <span class="section__subtitle" data-i18n="projects.subtitle">Trabajo seleccionado</span>

  <div class="projects__container container">
    <div class="projects__intro">
      <p data-i18n="projects.intro">
        Proyectos donde he trabajado en sistemas empresariales, interfaces responsivas,
        integracion de APIs, bases de datos y automatizacion de procesos.
      </p>
    </div>

    <div class="projects__grid">
      {
        projects.map((project, index) => {
          const slides = getProjectSlides(project);

          return (
          <article class="project">
            <a
              class="project__media"
              href={project.demoUrl || project.repoUrl || undefined}
              target={project.demoUrl || project.repoUrl ? '_blank' : undefined}
              rel={project.demoUrl || project.repoUrl ? 'noreferrer' : undefined}
              aria-label={`Ver proyecto ${project.title}`}
            >
              <span
                class="project__gallery"
                data-project-gallery
                data-project-interval={String(4300 + index * 280)}
                aria-label={`Galeria visual de ${project.title}`}
              >
                {
                  slides.map((slide, slideIndex) => (
                    <span
                      class={`project__slide ${slideIndex === 0 ? 'is-active' : ''}`}
                      data-project-slide
                      aria-hidden={slideIndex === 0 ? 'false' : 'true'}
                    >
                      {'src' in slide ? (
                        <img src={slide.src} alt={slide.alt} loading="lazy" />
                      ) : (
                        <span class={`project__visual project__visual--${slide.kind}`}>
                          <i class={`uil ${slide.icon}`}></i>
                          <em data-i18n={slide.key}>{slide.label}</em>
                          <strong>{project.title}</strong>
                          <small>{slide.kind === 'technology' ? project.stack.slice(0, 3).join(' · ') : project.type}</small>
                        </span>
                      )}
                    </span>
                  ))
                }

                <span class="project__gallery-dots" aria-hidden="true">
                  {slides.map((_, slideIndex) => (
                    <i class={slideIndex === 0 ? 'is-active' : ''} data-project-dot></i>
                  ))}
                </span>
              </span>
            </a>

            <div class="project__body">
              <div class="project__header">
                <span class="project__type" data-i18n={`projects.${index}.type`}>{project.type}</span>
                <h3>{project.title}</h3>
              </div>

              <p class="project__description" data-i18n={`projects.${index}.description`}>{project.description}</p>
              <p class="project__impact" data-i18n={`projects.${index}.impact`}>{project.impact}</p>

              <ul class="project__stack" aria-label={`Tecnologias usadas en ${project.title}`}>
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>

              <div class="project__links">
                {
                  project.demoUrl && (
                    <a href={project.demoUrl} target="_blank" rel="noreferrer">
                      Live
                      <i class="uil uil-external-link-alt"></i>
                    </a>
                  )
                }
                {
                  project.repoUrl && (
                    <a href={project.repoUrl} target="_blank" rel="noreferrer">
                      Code
                      <i class="uil uil-github-alt"></i>
                    </a>
                  )
                }
              </div>
            </div>
          </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .projects__container {
    display: grid;
    gap: 2rem;
  }

  .projects__intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    line-height: 1.75;
  }

  .projects__grid {
    display: grid;
    gap: 1.5rem;
  }

  .project {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .project__media {
    position: relative;
    min-height: 210px;
    border-radius: .75rem;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(85, 157, 226, .16), rgba(59, 130, 246, .05)),
      var(--container-color);
    border: 1px solid var(--border-color);
    display: block;
    color: var(--text-color-light);
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  .project__media:hover {
    transform: translateY(-3px);
    border-color: var(--first-color-lighter);
    box-shadow: 0 18px 35px rgba(39, 62, 84, .08);
  }

  .project__gallery {
    position: absolute;
    inset: 0;
    display: block;
  }

  .project__slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: scale(1.025);
    transition: opacity .65s ease, transform 1.1s ease;
    pointer-events: none;
  }

  .project__slide.is-active {
    z-index: 1;
    opacity: 1;
    transform: scale(1);
  }

  .project__slide img {
    width: 100%;
    height: 100%;
    min-height: 210px;
    object-fit: cover;
    display: block;
  }

  .project__visual {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: .4rem;
    overflow: hidden;
    padding: 2rem;
    text-align: center;
    background:
      radial-gradient(circle at 75% 20%, rgba(85, 157, 226, .22), transparent 28%),
      linear-gradient(145deg, rgba(255, 255, 255, .95), rgba(85, 157, 226, .12));
  }

  .project__visual::before,
  .project__visual::after {
    content: '';
    position: absolute;
    border: 1px solid rgba(85, 157, 226, .16);
    border-radius: 50%;
  }

  .project__visual::before {
    width: 11rem;
    height: 11rem;
    top: -6rem;
    right: -4rem;
  }

  .project__visual::after {
    width: 7rem;
    height: 7rem;
    left: -3rem;
    bottom: -4rem;
  }

  .project__visual i {
    color: var(--first-color);
    font-size: clamp(2.2rem, 7vw, 3.5rem);
  }

  .project__visual em {
    color: var(--first-color);
    font-style: normal;
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .project__visual strong {
    color: var(--title-color);
    font-size: clamp(1.35rem, 4vw, 2rem);
  }

  .project__visual small {
    color: var(--text-color-light);
    font-size: var(--small-font-size);
  }

  .project__visual--technology {
    background:
      linear-gradient(rgba(255, 255, 255, .88), rgba(255, 255, 255, .88)),
      repeating-linear-gradient(90deg, var(--first-color) 0 1px, transparent 1px 28px);
  }

  .project__visual--impact {
    background:
      linear-gradient(155deg, rgba(85, 157, 226, .2), rgba(255, 255, 255, .96) 58%),
      var(--container-color);
  }

  .project__gallery-dots {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: .8rem;
    display: flex;
    gap: .35rem;
    transform: translateX(-50%);
  }

  .project__gallery-dots i {
    width: .4rem;
    height: .4rem;
    border-radius: 999px;
    background: rgba(41, 56, 75, .24);
    transition: width .3s ease, background-color .3s ease;
  }

  .project__gallery-dots i.is-active {
    width: 1.1rem;
    background: var(--first-color);
  }

  .project__body {
    display: grid;
    gap: .85rem;
  }

  .project__type {
    color: var(--first-color);
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .project__header h3 {
    font-size: var(--h2-font-size);
    margin-top: .2rem;
  }

  .project__description,
  .project__impact {
    line-height: 1.7;
  }

  .project__impact {
    color: var(--text-color-light);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .project__stack li {
    color: var(--title-color);
    background-color: var(--input-color);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: .35rem .7rem;
    font-size: var(--smaller-font-size);
  }

  .project__links {
    display: flex;
    gap: 1rem;
    min-height: 1.5rem;
  }

  .project__links a {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    color: var(--first-color);
    font-weight: var(--font-medium);
    transition: color .25s ease, transform .25s ease;
  }

  .project__links a:hover {
    color: var(--first-color-alt);
    transform: translateX(2px);
  }

  @media screen and (min-width: 768px) {
    .project {
      grid-template-columns: minmax(260px, 42%) minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
    }

    .project:nth-child(even) .project__media {
      order: 2;
    }
  }

  @media screen and (min-width: 1080px) {
    .projects__grid {
      gap: 2rem;
    }

    .project__media,
    .project__slide img {
      min-height: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project__slide {
      transition: none;
    }
  }
</style>
