---
import { profile } from '../data/profile';

const [leftSide, rightSide] = profile.heroSides;
---

<main class="main">
  <section class="home section reveal" id="home">
    <div class="home__container container">
      <p class="home__intro">Hola, soy {profile.name}</p>

      <div class="home__stage">
        <article class="home__side home__side--left">
          <h1 class="home__side-title">{leftSide.title}</h1>
          <p>{leftSide.description}</p>
        </article>

        <figure class="home__portrait" aria-label={`Foto de ${profile.name}`}>
          <span class="home__portrait-bg"></span>
          <img src={profile.photo} alt={`Foto de ${profile.name}`} class="home__portrait-img" />
        </figure>

        <article class="home__side home__side--right">
          <h2 class="home__side-title">{rightSide.title}</h2>
          <p>{rightSide.description}</p>
        </article>
      </div>

      <div class="home__details">
        <div>
          <span class="home__role">{profile.role}</span>
          <p class="home__description">{profile.tagline}</p>
        </div>

        <div class="home__actions">
          <a href={profile.cv} download class="button button--flex">
            Descargar CV
            <i class="uil uil-download-alt button__icon"></i>
          </a>
          <a href={`mailto:${profile.email}`} class="button button--ghost button--flex">
            Escribeme
            <i class="uil uil-message button__icon"></i>
          </a>
        </div>
      </div>

      <div class="home__footer">
        <div class="home__social">
          <a href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" class="home__social-icon">
            <i class="uil uil-linkedin-alt"></i>
          </a>

          <a href={`mailto:${profile.email}`} aria-label="Email" class="home__social-icon">
            <i class="uil uil-envelope"></i>
          </a>

          <a href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub" class="home__social-icon">
            <i class="uil uil-github-alt"></i>
          </a>
        </div>

        <a href="#about" class="home__scroll-button button--flex">
          <i class="uil uil-mouse-alt home__scroll-mouse"></i>
          <span class="home__scroll-name">Scroll down</span>
          <i class="uil uil-arrow-down home__scroll-arrow"></i>
        </a>
      </div>
    </div>
  </section>
</main>

<style>
  .home {
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--header-height));
    padding-top: 2rem;
  }

  .home__container {
    display: grid;
    gap: 1.5rem;
    animation: fadeUp .7s ease both;
  }

  .home__intro {
    color: var(--first-color);
    font-size: var(--small-font-size);
    font-weight: var(--font-medium);
    text-align: center;
  }

  .home__stage {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .home__side {
    text-align: center;
  }

  .home__side-title {
    font-size: clamp(2.35rem, 12vw, 4.25rem);
    line-height: .9;
    letter-spacing: 0;
    margin-bottom: var(--mb-0-75);
  }

  .home__side p {
    max-width: 320px;
    margin: 0 auto;
    color: var(--text-color-light);
    line-height: 1.65;
  }

  .home__portrait {
    position: relative;
    width: min(72vw, 340px);
    aspect-ratio: 1 / 1.08;
    justify-self: center;
    display: grid;
    place-items: end center;
    overflow: hidden;
    animation: quietFloat 6s ease-in-out infinite;
  }

  .home__portrait-bg {
    position: absolute;
    inset: 12% 4% 2%;
    background: linear-gradient(145deg, var(--first-color), var(--first-color-alt));
    border-radius: 44% 56% 46% 54% / 50% 44% 56% 50%;
    box-shadow: 0 22px 48px rgba(40, 104, 170, .16);
  }

  .home__portrait::before,
  .home__portrait::after {
    position: absolute;
    color: hsl(var(--hue-color), 18%, 82%);
    font-family: Consolas, monospace;
    font-size: .82rem;
    line-height: 1.6;
    opacity: .65;
    pointer-events: none;
  }

  .home__portrait::before {
    content: '<main>\\A class="profile"';
    left: 0;
    bottom: 16%;
  }

  .home__portrait::after {
    content: 'SELECT *\\A FROM skills;';
    right: 0;
    top: 18%;
  }

  .home__portrait-img {
    position: relative;
    z-index: 1;
    width: 82%;
    height: 92%;
    object-fit: cover;
    object-position: center top;
    border-radius: 0 0 44% 44%;
    filter: drop-shadow(0 18px 20px rgba(39, 62, 84, .16));
  }

  .home__details {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
  }

  .home__role {
    display: block;
    color: var(--title-color);
    font-size: var(--h3-font-size);
    font-weight: var(--font-medium);
    margin-bottom: var(--mb-0-5);
  }

  .home__description {
    max-width: 620px;
    line-height: 1.7;
  }

  .home__actions,
  .home__social,
  .home__footer {
    display: flex;
    align-items: center;
  }

  .home__actions {
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem;
  }

  .home__footer {
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .home__social {
    gap: 1rem;
  }

  .home__social-icon {
    font-size: 1.25rem;
    color: var(--first-color);
    transition: color .25s ease, transform .25s ease;
  }

  .home__social-icon:hover {
    color: var(--first-color-alt);
    transform: translateY(-2px);
  }

  .home__scroll-button {
    color: var(--first-color);
    transition: transform .25s ease;
  }

  .home__scroll-button:hover {
    transform: translateY(0.25rem);
  }

  .home__scroll-mouse {
    font-size: 2rem;
  }

  .home__scroll-name {
    font-size: var(--small-font-size);
    color: var(--title-color);
    font-weight: var(--font-medium);
    margin-left: var(--mb-0-25);
  }

  .home__scroll-arrow {
    font-size: 1.25rem;
    margin-left: var(--mb-0-25);
  }

  @media screen and (min-width: 768px) {
    .home {
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }

    .home__stage {
      grid-template-columns: minmax(190px, 1fr) minmax(300px, 380px) minmax(190px, 1fr);
      gap: clamp(1.5rem, 4vw, 4rem);
    }

    .home__side--left {
      text-align: left;
      justify-self: end;
    }

    .home__side--right {
      text-align: left;
      justify-self: start;
    }

    .home__side p {
      margin: 0;
    }

    .home__side-title {
      font-size: clamp(3rem, 5.5vw, 4.75rem);
    }

    .home__details {
      grid-template-columns: minmax(0, 1fr) max-content;
      align-items: center;
      text-align: left;
      justify-items: stretch;
      max-width: 920px;
      width: 100%;
      margin: 0 auto;
    }

    .home__actions {
      justify-content: flex-end;
    }

    .home__footer {
      justify-content: space-between;
      max-width: 920px;
      width: 100%;
      margin: 0 auto;
    }
  }

  @media screen and (min-width: 1120px) {
    .home__stage {
      grid-template-columns: minmax(250px, 1fr) minmax(360px, 430px) minmax(250px, 1fr);
    }

    .home__portrait {
      width: min(32vw, 430px);
    }
  }
</style>
