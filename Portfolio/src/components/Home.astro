---
import { profile } from '../data/profile';

const [leftSide, rightSide] = profile.heroSides;
---

<main class="main">
  <section class="home section reveal" id="home">
    <div class="home__container container">
      <div class="home__heading">
        <p class="home__intro" data-i18n="home.intro">Hola, soy</p>
        <h1 class="home__name">{profile.name}</h1>
        <span class="home__role" data-i18n="home.role">{profile.role}</span>
        <p class="home__description" data-i18n="home.tagline">{profile.tagline}</p>
      </div>

      <div class="home__stage">
        <article class="home__side home__side--left">
          <h1 class="home__side-title" data-i18n="home.left.title">{leftSide.title}</h1>
          <p data-i18n="home.left.description">{leftSide.description}</p>
        </article>

        <figure class="home__portrait" aria-label={`Foto de ${profile.name}`}>
          <span class="home__portrait-bg"></span>
          <img src={profile.photo} alt={`Foto de ${profile.name}`} class="home__portrait-img" />
        </figure>

        <article class="home__side home__side--right">
          <h2 class="home__side-title" data-i18n="home.right.title">{rightSide.title}</h2>
          <p data-i18n="home.right.description">{rightSide.description}</p>
        </article>
      </div>

      <div class="home__footer">
        <a href="#about" class="home__scroll-button button--flex">
          <i class="uil uil-mouse-alt home__scroll-mouse"></i>
          <span class="home__scroll-name" data-i18n="home.scroll">Desliza abajo</span>
          <i class="uil uil-arrow-down home__scroll-arrow"></i>
        </a>
      </div>
    </div>
  </section>
</main>

<style>
  .home {
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--header-height));
    padding-top: 2rem;
  }

  .home__container {
    display: grid;
    gap: 1.65rem;
    animation: fadeUp .7s ease both;
  }

  .home__heading {
    display: grid;
    justify-items: center;
    gap: .35rem;
    text-align: center;
  }

  .home__intro {
    color: var(--first-color);
    font-size: var(--small-font-size);
    font-weight: var(--font-medium);
  }

  .home__name {
    max-width: 980px;
    font-size: clamp(2.8rem, 8vw, 6.25rem);
    line-height: .96;
    letter-spacing: 0;
  }

  .home__stage {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .home__side {
    text-align: center;
  }

  .home__side-title {
    font-size: clamp(2.35rem, 12vw, 4.25rem);
    line-height: .9;
    letter-spacing: 0;
    margin-bottom: var(--mb-0-75);
  }

  .home__side p {
    max-width: 320px;
    margin: 0 auto;
    color: var(--text-color-light);
    line-height: 1.65;
  }

  .home__portrait {
    position: relative;
    width: min(72vw, 360px);
    aspect-ratio: 1 / 1.08;
    justify-self: center;
    display: grid;
    place-items: end center;
    overflow: hidden;
    animation: quietFloat 6s ease-in-out infinite;
  }

  .home__portrait-bg {
    position: absolute;
    inset: 12% 4% 2%;
    background: linear-gradient(145deg, var(--first-color), var(--first-color-alt));
    border-radius: 44% 56% 46% 54% / 50% 44% 56% 50%;
    box-shadow: 0 22px 48px rgba(40, 104, 170, .16);
  }

  .home__portrait::before,
  .home__portrait::after {
    position: absolute;
    color: hsl(var(--hue-color), 18%, 82%);
    font-family: Consolas, monospace;
    font-size: .82rem;
    line-height: 1.6;
    opacity: .65;
    pointer-events: none;
  }

  .home__portrait::before {
    content: '<main>\\A class="profile"';
    left: 0;
    bottom: 16%;
  }

  .home__portrait::after {
    content: 'SELECT *\\A FROM skills;';
    right: 0;
    top: 18%;
  }

  .home__portrait-img {
    position: relative;
    z-index: 1;
    width: 82%;
    height: 92%;
    object-fit: cover;
    object-position: center top;
    border-radius: 0 0 44% 44%;
    filter: drop-shadow(0 18px 20px rgba(39, 62, 84, .16));
  }

  .home__role {
    display: block;
    color: var(--title-color);
    font-size: var(--h3-font-size);
    font-weight: var(--font-medium);
  }

  .home__description {
    max-width: 620px;
    line-height: 1.7;
  }

  .home__footer {
    display: flex;
    align-items: center;
  }

  .home__footer {
    justify-content: center;
  }

  .home__scroll-button {
    color: var(--first-color);
    transition: transform .25s ease;
  }

  .home__scroll-button:hover {
    transform: translateY(0.25rem);
  }

  .home__scroll-mouse {
    font-size: 2rem;
  }

  .home__scroll-name {
    font-size: var(--small-font-size);
    color: var(--title-color);
    font-weight: var(--font-medium);
    margin-left: var(--mb-0-25);
  }

  .home__scroll-arrow {
    font-size: 1.25rem;
    margin-left: var(--mb-0-25);
  }

  @media screen and (min-width: 768px) {
    .home {
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }

    .home__stage {
      grid-template-columns: minmax(190px, 1fr) minmax(310px, 400px) minmax(190px, 1fr);
      gap: clamp(1.5rem, 4vw, 4rem);
    }

    .home__side--left {
      text-align: left;
      justify-self: end;
    }

    .home__side--right {
      text-align: left;
      justify-self: start;
    }

    .home__side p {
      margin: 0;
    }

    .home__side-title {
      font-size: clamp(3rem, 5.5vw, 4.75rem);
    }

    .home__footer {
      justify-content: center;
      margin-top: .25rem;
    }
  }

  @media screen and (min-width: 1120px) {
    .home__stage {
      grid-template-columns: minmax(250px, 1fr) minmax(360px, 430px) minmax(250px, 1fr);
    }

    .home__portrait {
      width: min(32vw, 440px);
    }
  }
</style>
