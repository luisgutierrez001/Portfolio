---
import { profile } from '../data/profile';

const [leftSide, rightSide] = profile.heroSides;
---

<main class="main">
  <section class="home section reveal" id="home">
    <div class="home__container container">
      <div class="home__heading">
        <p class="home__intro" data-i18n="home.intro">Hola, soy</p>
        <h1 class="home__name">{profile.name}</h1>
        <span class="home__role" data-i18n="home.role">{profile.role}</span>
        <p class="home__description" data-i18n="home.tagline">{profile.tagline}</p>
      </div>

      <div class="home__stage">
        <article class="home__side home__side--left">
          <h2 class="home__side-title" data-i18n="home.right.title">{rightSide.title}</h2>
          <p data-i18n="home.right.description">{rightSide.description}</p>
        </article>

        <figure class="home__portrait" aria-label={`Foto de ${profile.name}`}>
          <span class="home__portrait-mask">
            <span class="home__portrait-bg"></span>
            <span class="home__code-layer" aria-hidden="true">
              <code class="home__code home__code--top-left">const idea = 'simple';</code>
              <code class="home__code home__code--top-right">SELECT * FROM skills;</code>
              <code class="home__code home__code--middle-left">display: grid;</code>
              <code class="home__code home__code--middle-right">return &lt;Solution /&gt;;</code>
              <code class="home__code home__code--bottom-left">&lt;main class="portfolio"&gt;</code>
              <code class="home__code home__code--bottom-right">@media (width &lt; 768px)</code>
            </span>
            <img src={profile.photo} alt={`Foto de ${profile.name}`} class="home__portrait-img" />
          </span>
        </figure>

        <article class="home__side home__side--right">
          <h2 class="home__side-title" data-i18n="home.left.title">{leftSide.title}</h2>
          <p data-i18n="home.left.description">{leftSide.description}</p>
        </article>
      </div>

      <div class="home__footer">
        <a href="#about" class="home__scroll-button button--flex">
          <i class="uil uil-mouse-alt home__scroll-mouse"></i>
          <span class="home__scroll-name" data-i18n="home.scroll">Desliza abajo</span>
          <i class="uil uil-arrow-down home__scroll-arrow"></i>
        </a>
      </div>
    </div>
  </section>
</main>

<style>
  .home {
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--header-height));
    padding-top: 2rem;
  }

  .home__container {
    display: grid;
    gap: 1.65rem;
  }

  .home__heading {
    display: grid;
    justify-items: center;
    gap: .35rem;
    text-align: center;
  }

  .home__intro {
    color: var(--first-color);
    font-size: var(--small-font-size);
    font-weight: var(--font-medium);
  }

  .home__name {
    max-width: 980px;
    font-size: clamp(2.8rem, 8vw, 6.25rem);
    line-height: .96;
    letter-spacing: 0;
  }

  .home__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    gap: .85rem;
    align-items: center;
    isolation: isolate;
  }

  .home__side {
    z-index: 2;
    width: 100%;
    text-align: center;
  }

  .home__side-title {
    font-size: clamp(2rem, 10vw, 2.75rem);
    line-height: .9;
    letter-spacing: 0;
    margin: 0;
    white-space: nowrap;
  }

  .home__side p {
    display: none;
  }

  .home__side--left {
    grid-column: 1;
    grid-row: 3;
    justify-self: center;
  }

  .home__side--right {
    grid-column: 1;
    grid-row: 1;
    justify-self: center;
  }

  .home__portrait {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 2;
    width: min(76vw, 320px);
    aspect-ratio: 1 / 1.08;
    justify-self: center;
    display: grid;
    place-items: end center;
  }

  .home__portrait-mask {
    position: absolute;
    inset: 10% 0 0;
    overflow: hidden;
    border-radius: 46% 54% 43% 57% / 48% 45% 55% 52%;
    box-shadow: 0 22px 48px rgba(40, 104, 170, .16);
  }

  .home__portrait-bg {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(145deg, var(--first-color), var(--first-color-alt));
  }

  .home__code-layer {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }

  .home__code {
    position: absolute;
    color: rgba(255, 255, 255, .58);
    font-family: Consolas, monospace;
    font-size: clamp(.55rem, 1.8vw, .78rem);
    font-weight: 400;
    line-height: 1;
    opacity: .8;
    white-space: nowrap;
  }

  .home__code--top-left {
    top: 12%;
    left: 8%;
  }

  .home__code--top-right {
    top: 15%;
    right: 7%;
  }

  .home__code--middle-left {
    top: 43%;
    left: 5%;
  }

  .home__code--middle-right {
    top: 48%;
    right: 5%;
  }

  .home__code--bottom-left {
    bottom: 20%;
    left: 9%;
  }

  .home__code--bottom-right {
    right: 8%;
    bottom: 13%;
  }

  .home__portrait-img {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: drop-shadow(0 18px 20px rgba(39, 62, 84, .16));
  }

  .js .home__intro,
  .js .home__name,
  .js .home__role,
  .js .home__description,
  .js .home__portrait-bg,
  .js .home__code-layer,
  .js .home__portrait-img,
  .js .home__side,
  .js .home__footer {
    opacity: 0;
  }

  .js .home.in-view .home__intro {
    animation: heroFade .35s ease-out .05s both;
  }

  .js .home.in-view .home__name {
    animation: nameFromTop .65s cubic-bezier(.22, 1, .36, 1) .12s both;
  }

  .js .home.in-view .home__role,
  .js .home.in-view .home__description {
    animation: heroFade .5s ease-out both;
  }

  .js .home.in-view .home__role {
    animation-delay: .48s;
  }

  .js .home.in-view .home__description {
    animation-delay: .58s;
  }

  .js .home.in-view .home__portrait-bg {
    animation: shapeIn .55s cubic-bezier(.22, 1, .36, 1) .72s both;
  }

  .js .home.in-view .home__portrait-img {
    animation: portraitIn .6s cubic-bezier(.22, 1, .36, 1) .94s both;
  }

  .js .home.in-view .home__code-layer {
    animation: codeIn .55s ease-out 1.12s both;
  }

  .js .home.in-view .home__side--left {
    animation: revealLeft .55s cubic-bezier(.22, 1, .36, 1) 1.18s both;
  }

  .js .home.in-view .home__side--right {
    animation: revealRight .55s cubic-bezier(.22, 1, .36, 1) 1.18s both;
  }

  .js .home.in-view .home__footer {
    animation: heroFade .4s ease-out 1.42s both;
  }

  @keyframes nameFromTop {
    from {
      opacity: 0;
      transform: translateY(-28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroFade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes shapeIn {
    from {
      opacity: 0;
      transform: scale(.78) rotate(-5deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  @keyframes portraitIn {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes codeIn {
    from {
      opacity: 0;
      transform: scale(.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes revealLeft {
    from {
      opacity: 0;
      transform: translateX(52%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes revealRight {
    from {
      opacity: 0;
      transform: translateX(-52%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .home__intro,
    .js .home__name,
    .js .home__role,
    .js .home__description,
    .js .home__portrait-bg,
    .js .home__code-layer,
    .js .home__portrait-img,
    .js .home__side,
    .js .home__footer {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .home__scroll-button {
      opacity: 1;
      transform: none;
      animation: none;
      will-change: auto;
    }
  }

  .home__role {
    display: block;
    color: var(--title-color);
    font-size: var(--h3-font-size);
    font-weight: var(--font-medium);
  }

  .home__description {
    max-width: 620px;
    line-height: 1.7;
  }

  .home__footer {
    display: flex;
    align-items: center;
  }

  .home__footer {
    justify-content: center;
  }

  .home__scroll-button {
    color: var(--first-color);
    animation: scrollInvitation 2.15s cubic-bezier(.45, 0, .55, 1) infinite;
    will-change: transform, opacity;
  }

  .home__scroll-button:hover {
    animation-play-state: paused;
    opacity: 1;
  }

  @keyframes scrollInvitation {
    0%,
    100% {
      opacity: .3;
      transform: translateY(-5px);
    }
    45% {
      opacity: 1;
      transform: translateY(5px);
    }
    70% {
      opacity: .65;
      transform: translateY(8px);
    }
  }

  .home__scroll-mouse {
    font-size: 2rem;
  }

  .home__scroll-name {
    font-size: var(--small-font-size);
    color: var(--title-color);
    font-weight: var(--font-medium);
    margin-left: var(--mb-0-25);
  }

  .home__scroll-arrow {
    font-size: 1.25rem;
    margin-left: var(--mb-0-25);
  }

  @media screen and (min-width: 1100px) {
    .home {
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }

    .home__stage {
      grid-template-columns: minmax(190px, 1fr) minmax(310px, 400px) minmax(190px, 1fr);
      gap: clamp(1.5rem, 4vw, 4rem);
    }

    .home__portrait {
      grid-column: 2;
      grid-row: 1;
    }

    .home__side {
      width: auto;
      z-index: 0;
    }

    .home__side--left {
      grid-column: 1;
      grid-row: 1;
      text-align: left;
      justify-self: end;
    }

    .home__side--right {
      grid-column: 3;
      grid-row: 1;
      text-align: left;
      justify-self: start;
    }

    .home__side p {
      display: block;
      max-width: 320px;
      margin: 0;
      color: var(--text-color-light);
      line-height: 1.65;
    }

    .home__side-title {
      font-size: clamp(3rem, 5.5vw, 4.75rem);
      margin-bottom: var(--mb-0-75);
    }

    .home__footer {
      justify-content: center;
      margin-top: .25rem;
    }
  }

  @media screen and (min-width: 1120px) {
    .home__stage {
      grid-template-columns: minmax(250px, 1fr) minmax(360px, 430px) minmax(250px, 1fr);
    }

    .home__portrait {
      width: min(32vw, 440px);
    }
  }

  @media screen and (max-width: 420px) {
    .home {
      min-height: auto;
      align-items: flex-start;
      padding-top: 1.25rem;
      padding-bottom: 2rem;
    }

    .home__container {
      gap: 1.25rem;
    }

    .home__name {
      max-width: 100%;
      font-size: clamp(2.25rem, 11vw, 2.8rem);
      overflow-wrap: anywhere;
    }

    .home__role {
      font-size: 1.05rem;
    }

    .home__description {
      font-size: var(--small-font-size);
      line-height: 1.55;
    }

    .home__portrait {
      width: min(78vw, 285px);
    }

    .home__code--middle-left,
    .home__code--middle-right,
    .home__code--bottom-right {
      display: none;
    }
  }
</style>
