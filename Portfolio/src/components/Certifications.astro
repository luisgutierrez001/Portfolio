---
import { certifications } from '../data/profile';

const highlighted = certifications.slice(-3).reverse();
---

<section class="certifications section reveal" id="certifications">
  <div class="certifications__container container">
    <a class="certifications__card" href="/certifications" aria-label="Ver certificaciones">
      <span class="certifications__eyebrow" data-i18n="certifications.cta.subtitle">
        Biblioteca opcional de credenciales
      </span>

      <span class="certifications__content">
        <span class="certifications__count" aria-hidden="true">
          <strong>{certifications.length}</strong>
          <small data-i18n="certifications.credentials">credenciales</small>
        </span>

        <span class="certifications__copy">
          <span class="certifications__title" data-i18n="certifications.cta.title">Certificaciones</span>
          <span class="certifications__description" data-i18n="certifications.cta.description">
            Mis certificados viven en una vista separada para mantener el portafolio enfocado, pero quien quiera conocer mas puede explorar la biblioteca completa.
          </span>
        </span>

        <span class="certifications__arrow" aria-hidden="true">
          <i class="uil uil-arrow-right"></i>
        </span>
      </span>

      <span class="certifications__preview" aria-hidden="true">
        {highlighted.map((certificate) => (
          <span>
            <i class="uil uil-award"></i>
            <strong>{certificate.title}</strong>
            <small>{certificate.issuer}</small>
          </span>
        ))}
      </span>

      <span class="certifications__note" data-i18n="certifications.cta.note">
        Credenciales, cursos y evidencias de aprendizaje
      </span>
    </a>
  </div>
</section>

<style>
  .certifications__container {
    display: grid;
  }

  .certifications__card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    overflow: hidden;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--border-color);
    border-radius: .85rem;
    background:
      linear-gradient(120deg, rgba(85, 157, 226, .14), rgba(255, 255, 255, .92) 42%),
      var(--container-color);
    color: inherit;
    box-shadow: 0 18px 42px rgba(39, 62, 84, .08);
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  .certifications__card:hover {
    transform: translateY(-3px);
    border-color: var(--first-color-lighter);
    box-shadow: 0 24px 52px rgba(39, 62, 84, .12);
  }

  .certifications__eyebrow,
  .certifications__note {
    color: var(--first-color);
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .certifications__content {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
  }

  .certifications__count {
    width: clamp(5rem, 13vw, 7.5rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    align-content: center;
    border-radius: .8rem;
    background: var(--first-color);
    color: #fff;
    box-shadow: 0 16px 30px rgba(40, 104, 170, .22);
  }

  .certifications__count strong {
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: .9;
  }

  .certifications__count small {
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
  }

  .certifications__copy {
    display: grid;
    gap: .45rem;
    min-width: 0;
  }

  .certifications__title {
    color: var(--title-color);
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: var(--font-semi-bold);
    line-height: 1;
  }

  .certifications__description {
    max-width: 680px;
    color: var(--text-color);
    line-height: 1.7;
  }

  .certifications__arrow {
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--first-color-lighter);
    border-radius: 50%;
    color: var(--first-color);
    font-size: 1.45rem;
    transition: transform .25s ease, background-color .25s ease, color .25s ease;
  }

  .certifications__card:hover .certifications__arrow {
    transform: translateX(4px);
    background: var(--first-color);
    color: #fff;
  }

  .certifications__preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
  }

  .certifications__preview span {
    min-width: 0;
    display: grid;
    gap: .18rem;
    padding: .85rem;
    border: 1px solid rgba(70, 96, 126, .1);
    border-radius: .65rem;
    background: rgba(255, 255, 255, .72);
  }

  .certifications__preview i {
    color: var(--first-color);
    font-size: 1.3rem;
  }

  .certifications__preview strong {
    color: var(--title-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .certifications__preview small {
    color: var(--text-color-light);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media screen and (max-width: 720px) {
    .certifications__content {
      grid-template-columns: 1fr auto;
    }

    .certifications__count {
      grid-column: 1 / -1;
      width: 100%;
      aspect-ratio: auto;
      min-height: 6rem;
    }

    .certifications__preview {
      grid-template-columns: 1fr;
    }
  }
</style>
