---
import { certifications } from '../data/profile';
---

<section class="certifications section reveal" id="certifications">
  <h2 class="section__title">Certifications</h2>
  <span class="section__subtitle">Continuous learning</span>

  <div class="certifications__container container">
    <p class="certifications__intro">
      Certificaciones y cursos que respaldan mi formacion tecnica, gestion de proyectos,
      metodologias agiles y crecimiento profesional.
    </p>

    <div class="certifications__grid">
      {
        certifications.map((certificate) => (
          <article class="certificate">
            <div class="certificate__top">
              <span class="certificate__category">{certificate.category}</span>
              <span class="certificate__date">{certificate.date}</span>
            </div>

            <div>
              <h3>{certificate.title}</h3>
              <p class="certificate__issuer">{certificate.issuer}</p>
            </div>

            <p class="certificate__description">{certificate.description}</p>

            <div class="certificate__links">
              {
                certificate.credentialUrl && (
                  <a href={certificate.credentialUrl} target="_blank" rel="noreferrer">
                    Ver certificado
                    <i class="uil uil-external-link-alt"></i>
                  </a>
                )
              }
              {
                certificate.downloadUrl && (
                  <a href={certificate.downloadUrl} target="_blank" rel="noreferrer" download>
                    Descargar
                    <i class="uil uil-download-alt"></i>
                  </a>
                )
              }
              {
                !certificate.credentialUrl && !certificate.downloadUrl && (
                  <span>
                    Link pendiente
                    <i class="uil uil-link-broken"></i>
                  </span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .certifications__container {
    display: grid;
    gap: 2rem;
  }

  .certifications__intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    line-height: 1.75;
  }

  .certifications__grid {
    display: grid;
    gap: 1rem;
  }

  .certificate {
    display: grid;
    gap: .85rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border-color);
    transition: border-color .25s ease, transform .25s ease;
  }

  .certificate:hover {
    border-color: var(--first-color-lighter);
    transform: translateY(-2px);
  }

  .certificate__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .certificate__category {
    color: var(--first-color);
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .certificate__date,
  .certificate__issuer,
  .certificate__description {
    color: var(--text-color-light);
  }

  .certificate__date {
    white-space: nowrap;
    font-size: var(--smaller-font-size);
  }

  .certificate h3 {
    font-size: var(--h3-font-size);
    line-height: 1.3;
    margin-bottom: .25rem;
  }

  .certificate__description {
    line-height: 1.65;
  }

  .certificate__links {
    display: flex;
    flex-wrap: wrap;
    gap: .9rem;
    min-height: 1.5rem;
  }

  .certificate__links a,
  .certificate__links span {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--first-color);
    font-size: var(--small-font-size);
    font-weight: var(--font-medium);
  }

  .certificate__links a {
    transition: color .25s ease, transform .25s ease;
  }

  .certificate__links a:hover {
    color: var(--first-color-alt);
    transform: translateX(2px);
  }

  .certificate__links span {
    color: var(--text-color-light);
  }

  @media screen and (min-width: 768px) {
    .certifications__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 2rem;
    }
  }

  @media screen and (min-width: 1080px) {
    .certifications__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
