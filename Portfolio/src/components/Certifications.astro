---
import { certifications } from '../data/profile';

const months: Record<string, number> = {
  enero: 1,
  febrero: 2,
  marzo: 3,
  abril: 4,
  mayo: 5,
  junio: 6,
  julio: 7,
  agosto: 8,
  septiembre: 9,
  octubre: 10,
  noviembre: 11,
  diciembre: 12,
};

const getCertificationIcon = (category: string) => {
  const normalizedCategory = category.toLowerCase();

  if (normalizedCategory.includes('inteligencia')) return 'uil-brain';
  if (normalizedCategory.includes('linux')) return 'uil-linux';
  if (normalizedCategory.includes('agile')) return 'uil-sync';
  if (normalizedCategory.includes('proyectos')) return 'uil-clipboard-alt';
  if (normalizedCategory.includes('habilidades')) return 'uil-heart';
  if (normalizedCategory.includes('crecimiento')) return 'uil-rocket';
  return 'uil-award';
};

const sortedCertifications = certifications
  .map((certificate, originalIndex) => {
    const [monthName, year] = certificate.date.toLowerCase().split(' ');
    const month = months[monthName] ?? 0;

    return {
      ...certificate,
      originalIndex,
      icon: getCertificationIcon(certificate.category),
      timestamp: Number(year) * 100 + month,
      isoDate: `${year}-${String(month).padStart(2, '0')}`,
    };
  })
  .sort((a, b) => b.timestamp - a.timestamp || a.title.localeCompare(b.title));
---

<section class="certifications section reveal" id="certifications">
  <h2 class="section__title" data-i18n="certifications.title">Certificaciones</h2>
  <span class="section__subtitle" data-i18n="certifications.subtitle">Aprendizaje continuo</span>

  <div class="certifications__container container">
    <p class="certifications__intro" data-i18n="certifications.intro">
      Certificaciones y cursos que respaldan mi formacion tecnica, gestion de proyectos,
      metodologias agiles y crecimiento profesional.
    </p>

    <div class="certifications__library">
      <div class="certifications__library-head">
        <div class="certifications__count">
          <strong>{certifications.length}</strong>
          <span data-i18n="certifications.credentials">credenciales</span>
        </div>

        <p data-i18n="certifications.hint">Selecciona una credencial para conocer los detalles</p>
      </div>

      <div class="certifications__scroll" data-certifications-list>
        {
          sortedCertifications.map((certificate) => (
            <details class="certificate">
              <summary>
                <span class="certificate__icon" aria-hidden="true">
                  <i class={`uil ${certificate.icon}`}></i>
                </span>

                <span class="certificate__summary">
                  <span
                    class="certificate__category"
                    data-i18n={`certifications.${certificate.originalIndex}.category`}
                  >
                    {certificate.category}
                  </span>
                  <strong>{certificate.title}</strong>
                  <small>{certificate.issuer}</small>
                </span>

                <time
                  class="certificate__date"
                  datetime={certificate.isoDate}
                  data-i18n={`certifications.${certificate.originalIndex}.date`}
                >
                  {certificate.date}
                </time>

                <i class="uil uil-angle-down certificate__arrow" aria-hidden="true"></i>
              </summary>

              <div class="certificate__details">
                <p data-i18n={`certifications.${certificate.originalIndex}.description`}>
                  {certificate.description}
                </p>

                <div class="certificate__links">
                  {
                    certificate.credentialUrl && (
                      <a href={certificate.credentialUrl} target="_blank" rel="noreferrer">
                        <i class="uil uil-external-link-alt"></i>
                        <span data-i18n="certifications.view">Ver certificado</span>
                      </a>
                    )
                  }
                  {
                    certificate.downloadUrl && (
                      <a href={certificate.downloadUrl} target="_blank" rel="noreferrer" download>
                        <i class="uil uil-download-alt"></i>
                        <span data-i18n="certifications.download">Descargar</span>
                      </a>
                    )
                  }
                  {
                    !certificate.credentialUrl && !certificate.downloadUrl && (
                      <span class="certificate__pending">
                        <i class="uil uil-link-broken"></i>
                        <span data-i18n="certifications.pending">Link pendiente</span>
                      </span>
                    )
                  }
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .certifications__container {
    display: grid;
    gap: 2rem;
  }

  .certifications__intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    line-height: 1.75;
  }

  .certifications__library {
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    background: var(--container-color);
    box-shadow: 0 18px 42px rgba(39, 62, 84, .08);
  }

  .certifications__library-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--border-color);
    background:
      linear-gradient(120deg, rgba(85, 157, 226, .11), transparent 50%),
      var(--container-color);
  }

  .certifications__library-head p {
    color: var(--text-color-light);
    font-size: var(--small-font-size);
    text-align: right;
  }

  .certifications__count {
    display: flex;
    align-items: baseline;
    gap: .45rem;
    color: var(--title-color);
  }

  .certifications__count strong {
    color: var(--first-color);
    font-size: 1.65rem;
    line-height: 1;
  }

  .certifications__count span {
    font-size: var(--small-font-size);
    font-weight: var(--font-medium);
  }

  .certifications__scroll {
    max-height: min(62vh, 590px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: .45rem .8rem .8rem;
    scrollbar-gutter: stable;
    scrollbar-color: var(--first-color-lighter) transparent;
    scrollbar-width: thin;
  }

  .certificate {
    border-bottom: 1px solid var(--border-color);
  }

  .certificate:last-child {
    border-bottom: 0;
  }

  .certificate summary {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto 1.25rem;
    align-items: center;
    gap: .85rem;
    padding: .9rem .6rem;
    border-radius: .65rem;
    cursor: pointer;
    list-style: none;
    transition: background-color .2s ease;
  }

  .certificate summary::-webkit-details-marker {
    display: none;
  }

  .certificate summary:hover,
  .certificate[open] summary {
    background: rgba(85, 157, 226, .07);
  }

  .certificate summary:focus-visible {
    outline: 2px solid var(--first-color);
    outline-offset: -2px;
  }

  .certificate__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: .75rem;
    display: grid;
    place-items: center;
    background: var(--first-color-lighter);
    color: var(--first-color-alt);
    font-size: 1.35rem;
  }

  .certificate__summary {
    display: grid;
    gap: .14rem;
    min-width: 0;
  }

  .certificate__summary strong {
    overflow: hidden;
    color: var(--title-color);
    font-size: var(--normal-font-size);
    line-height: 1.25;
    text-overflow: ellipsis;
  }

  .certificate__summary small,
  .certificate__date {
    color: var(--text-color-light);
    font-size: var(--smaller-font-size);
  }

  .certificate__category {
    color: var(--first-color);
    font-size: .67rem;
    font-weight: var(--font-medium);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .certificate__date {
    white-space: nowrap;
  }

  .certificate__arrow {
    color: var(--first-color);
    font-size: 1.2rem;
    transition: transform .25s ease;
  }

  .certificate[open] .certificate__arrow {
    transform: rotate(180deg);
  }

  .certificate__details {
    display: grid;
    gap: .85rem;
    margin: 0 2.1rem 1rem 4.2rem;
    padding: .9rem 1rem;
    border-left: 2px solid var(--first-color);
    border-radius: 0 .55rem .55rem 0;
    background: rgba(85, 157, 226, .045);
  }

  .certificate__details p {
    color: var(--text-color);
    line-height: 1.55;
  }

  .certificate__links {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
  }

  .certificate__links a,
  .certificate__pending {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .38rem .65rem;
    border: 1px solid var(--border-color);
    border-radius: .45rem;
    color: var(--first-color);
    background: var(--container-color);
    font-size: var(--small-font-size);
    font-weight: var(--font-medium);
  }

  .certificate__links a {
    transition: transform .2s ease, border-color .2s ease;
  }

  .certificate__links a:hover {
    transform: translateY(-2px);
    border-color: var(--first-color-lighter);
  }

  .certificate__pending {
    color: var(--text-color-light);
  }

  @media screen and (max-width: 640px) {
    .certifications__library-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .certifications__library-head p {
      text-align: left;
    }

    .certifications__scroll {
      max-height: 68vh;
      padding-inline: .45rem;
    }

    .certificate summary {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.15rem;
      gap: .65rem;
      padding-inline: .4rem;
    }

    .certificate__icon {
      width: 2.5rem;
      height: 2.5rem;
    }

    .certificate__date {
      grid-column: 2;
      grid-row: 2;
    }

    .certificate__arrow {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    .certificate__details {
      margin: 0 .4rem .85rem 3.55rem;
    }
  }

  @media screen and (max-width: 420px) {
    .certifications__container {
      gap: 1.25rem;
    }

    .certifications__library-head {
      padding: .85rem;
    }

    .certificate summary {
      grid-template-columns: 2.35rem minmax(0, 1fr) 1rem;
      gap: .55rem;
    }

    .certificate__icon {
      width: 2.35rem;
      height: 2.35rem;
      font-size: 1.15rem;
    }

    .certificate__details {
      margin-left: .4rem;
      padding: .8rem;
    }

    .certificate__links {
      display: grid;
    }

    .certificate__links a,
    .certificate__pending {
      justify-content: center;
    }
  }
</style>
