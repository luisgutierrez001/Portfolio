---
import { skillGroups } from '../data/profile';

const getSkillLevel = (score: number) => {
  if (score >= 86) return { key: 'middleAdvanced', label: 'Middle avanzado' };
  if (score >= 75) return { key: 'middle', label: 'Middle' };
  if (score >= 67) return { key: 'nearMiddle', label: 'Cerca de Middle' };
  if (score >= 62) return { key: 'juniorAdvanced', label: 'Junior avanzado' };
  return { key: 'junior', label: 'Junior' };
};
---

<section class="skills section reveal" id="skills">
  <h2 class="section__title" data-i18n="skills.title">Habilidades</h2>
  <span class="section__subtitle" data-i18n="skills.subtitle">Enfoque tecnico</span>

  <div class="skills__container container grid">
    {
      skillGroups.map((group) => (
        <div class={`skills__content ${group.open ? 'skills__open' : 'skills__close'}`}>
          <button class="skills__header" type="button" aria-expanded={group.open ? 'true' : 'false'}>
            <i class={`uil ${group.icon} skills__icon`}></i>

            <span class="skills__heading">
              <span class="skills__title" data-i18n={`skills.group.${skillGroups.indexOf(group)}.title`}>{group.title}</span>
              <span class="skills__subtitle" data-i18n={`skills.group.${skillGroups.indexOf(group)}.subtitle`}>{group.subtitle}</span>
            </span>

            <i class="uil uil-angle-down skills__arrow"></i>
          </button>

          <div class="skills__list grid">
            {
              group.skills.map((skill, skillIndex) => {
                const level = getSkillLevel(skill.level);

                return (
                  <div class="skills__data">
                    <div class="skills__titles">
                      <h3 class="skills__name" data-i18n={`skills.item.${skill.name}`}>{skill.name}</h3>
                      <span class="skills__number" data-i18n={`skills.level.${level.key}`}>{level.label}</span>
                    </div>
                    <div class="skills__bar" aria-hidden="true">
                      <span
                        class="skills__percentage"
                        style={`width: ${skill.level}%; --skill-index: ${skillIndex}`}
                      ></span>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills__container {
    row-gap: .75rem;
    animation: fadeUp .7s ease both;
  }

  .skills__content {
    padding: .5rem .25rem;
    border-bottom: 1px solid var(--border-color);
    transition: background-color .25s ease, border-color .25s ease, transform .25s ease;
  }

  .skills__content:hover {
    border-color: var(--first-color-lighter);
  }

  .skills__header {
    display: flex;
    width: 100%;
    align-items: center;
    gap: .75rem;
    padding: 1rem 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .skills__icon,
  .skills__arrow {
    flex: 0 0 auto;
    font-size: 2rem;
    color: var(--first-color);
  }

  .skills__title {
    display: block;
    font-size: var(--h3-font-size);
    color: var(--title-color);
    font-weight: var(--font-semi-bold);
  }

  .skills__subtitle {
    display: block;
    font-size: var(--small-font-size);
    color: var(--text-color-light);
  }

  .skills__heading {
    min-width: 0;
  }

  .skills__arrow {
    margin-left: auto;
    transition: transform 0.3s ease;
  }

  .skills__titles {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--mb-0-5);
  }

  .skills__name {
    font-size: var(--normal-font-size);
    font-weight: var(--font-medium);
  }

  .skills__number {
    flex: 0 0 auto;
    padding: .22rem .55rem;
    border: 1px solid rgba(85, 157, 226, .24);
    border-radius: 999px;
    background: rgba(85, 157, 226, .08);
    color: var(--first-color-alt);
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
  }

  .skills__bar,
  .skills__percentage {
    height: 5px;
    border-radius: 0.25rem;
  }

  .skills__bar {
    background-color: var(--first-color-lighter);
  }

  .skills__percentage {
    display: block;
    background-color: var(--first-color);
    transform-origin: left;
    transition: transform .7s ease;
  }

  .js .skills__percentage {
    transform: scaleX(0);
  }

  .js .skills.in-view .skills__content.skills__open .skills__percentage {
    transform: scaleX(1);
    transition-delay: calc(var(--skill-index) * 70ms);
  }

  .skills__close .skills__list {
    height: 0;
    overflow: hidden;
  }

  .skills__open .skills__list {
    height: max-content;
    margin-bottom: var(--mb-2-5);
  }

  .skills__open .skills__arrow {
    transform: rotate(-180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .js .skills__percentage {
      transition-delay: 0ms;
    }
  }

  @media screen and (min-width: 768px) {
    .skills__container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 3rem;
    }

    .skills__content {
      padding: .75rem .5rem;
    }
  }

  @media screen and (min-width: 1024px) {
    .skills__container {
      max-width: 980px;
    }
  }

  @media screen and (max-width: 420px) {
    .skills__titles {
      align-items: flex-start;
      flex-direction: column;
      gap: .4rem;
    }
  }
</style>
