---
import { experiences } from '../data/profile';
---

<section class="experience section reveal" id="experience">
  <h2 class="section__title" data-i18n="experience.title">Experiencia</h2>
  <span class="section__subtitle" data-i18n="experience.subtitle">Trayectoria profesional</span>

  <div class="experience__container container">
    <p class="experience__intro" data-i18n="experience.intro">
      Experiencia construyendo sistemas web empresariales, modulos administrativos,
      integraciones backend y soluciones orientadas a procesos reales.
    </p>

    <div class="experience__timeline">
      {
        experiences.map((item, index) => (
          <article class="experience__item">
            <div class="experience__marker" aria-hidden="true"></div>

            <div class={`experience__content ${item.media.length > 0 ? 'experience__content--with-media' : ''}`}>
              <div class="experience__details">
                <div class="experience__meta">
                  <span data-i18n={`experience.${index}.type`}>{item.type}</span>
                  <span data-i18n={`experience.${index}.period`}>{item.period}</span>
                </div>

                <div class="experience__header">
                  <h3 data-i18n={`experience.${index}.role`}>{item.role}</h3>
                  <p>{item.company} · <span data-i18n={`experience.${index}.location`}>{item.location}</span></p>
                </div>

                <p class="experience__description" data-i18n={`experience.${index}.description`}>{item.description}</p>

                <ul class="experience__highlights">
                  {item.highlights.map((highlight, highlightIndex) => (
                    <li data-i18n={`experience.${index}.highlight.${highlightIndex}`}>{highlight}</li>
                  ))}
                </ul>

                <ul class="experience__stack" aria-label={`Tecnologias y procesos en ${item.company}`}>
                  {item.stack.map((tech) => <li>{tech}</li>)}
                </ul>
              </div>

              {
                item.media.length > 0 && (
                  <aside
                    class={`experience__media experience__media--${Math.min(item.media.length, 3)}`}
                    aria-label={`Momentos de ${item.company}`}
                  >
                    {item.media.slice(0, 3).map((image) => (
                      <img src={image.src} alt={image.alt} loading="lazy" />
                    ))}
                  </aside>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experience__container {
    display: grid;
    gap: 2.5rem;
  }

  .experience__intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    line-height: 1.75;
  }

  .experience__timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .experience__timeline::before {
    content: '';
    position: absolute;
    top: .75rem;
    bottom: .75rem;
    left: .45rem;
    width: 1px;
    background: var(--border-color);
  }

  .experience__item {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 1rem;
  }

  .experience__marker {
    width: .9rem;
    height: .9rem;
    margin-top: .45rem;
    border-radius: 50%;
    background: var(--first-color);
    box-shadow: 0 0 0 6px var(--first-color-lighter);
    z-index: 1;
  }

  .experience__content {
    display: grid;
    gap: 1.15rem;
    padding: 1.25rem 0 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .experience__details {
    display: grid;
    gap: .85rem;
    min-width: 0;
  }

  .experience__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    color: var(--first-color);
    font-size: var(--smaller-font-size);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .experience__header h3 {
    font-size: var(--h2-font-size);
    margin-bottom: .25rem;
  }

  .experience__header p {
    color: var(--text-color-light);
  }

  .experience__description,
  .experience__highlights {
    line-height: 1.7;
  }

  .experience__highlights {
    display: grid;
    gap: .55rem;
  }

  .experience__highlights li {
    position: relative;
    padding-left: 1.15rem;
  }

  .experience__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .72em;
    width: .35rem;
    height: .35rem;
    border-radius: 50%;
    background: var(--accent-color);
  }

  .experience__stack {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .experience__stack li {
    color: var(--title-color);
    background-color: var(--input-color);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: .35rem .7rem;
    font-size: var(--smaller-font-size);
  }

  .experience__media {
    position: relative;
    width: min(100%, 18rem);
    min-height: 9rem;
    justify-self: start;
    isolation: isolate;
  }

  .experience__media::before {
    content: '';
    position: absolute;
    inset: .75rem -.5rem -.5rem .75rem;
    z-index: -1;
    border: 1px solid rgba(85, 157, 226, .28);
    border-radius: .75rem;
  }

  .experience__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 9rem;
    border-radius: .7rem;
    object-fit: cover;
    box-shadow: 0 14px 28px rgba(39, 62, 84, .12);
  }

  .experience__media--1 {
    aspect-ratio: 16 / 9;
    transform: rotate(-1deg);
  }

  .experience__media--2 {
    height: 12rem;
  }

  .experience__media--2 img {
    position: absolute;
    width: 72%;
    height: 76%;
    min-height: 0;
  }

  .experience__media--2 img:first-child {
    top: 0;
    left: 0;
    transform: rotate(-2deg);
  }

  .experience__media--2 img:last-child {
    right: 0;
    bottom: 0;
    border: 4px solid var(--body-color);
    transform: rotate(2deg);
  }

  .experience__media--3 {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    grid-template-rows: 1fr 1fr;
    gap: .35rem;
    height: 12rem;
    transform: rotate(-1deg);
  }

  .experience__media--3 img {
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: .5rem;
  }

  .experience__media--3 img:first-child {
    grid-row: 1 / 3;
  }

  @media screen and (min-width: 768px) {
    .experience__timeline {
      max-width: 1040px;
      margin: 0 auto;
    }

    .experience__item {
      grid-template-columns: 1rem minmax(0, 1fr);
      gap: 1.5rem;
    }

    .experience__content {
      padding: 1.4rem 0 1.75rem;
    }

    .experience__content--with-media {
      grid-template-columns: minmax(0, 1fr) minmax(170px, 220px);
      align-items: center;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .experience__media {
      justify-self: end;
    }
  }

  @media screen and (max-width: 420px) {
    .experience__item {
      gap: .7rem;
    }

    .experience__content {
      padding-top: .75rem;
    }

    .experience__meta {
      flex-direction: column;
      gap: .25rem;
    }

    .experience__media {
      width: calc(100% - .5rem);
    }

    .experience__media--2,
    .experience__media--3 {
      height: 10rem;
    }
  }
</style>
